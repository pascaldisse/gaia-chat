# Core AI Engine Configuration
# Copy this file to .env and add your API keys

# Required: DeepInfra API Key
# Get your key from: https://deepinfra.com/
DEEPINFRA_API_KEY=your-deepinfra-api-key-here

# Optional: OpenAI API Key
# For GPT models - Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Anthropic API Key
# For Claude models - Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Tavily API Key
# For enhanced web search - Get from: https://tavily.com/
TAVILY_API_KEY=your-tavily-api-key-here

# Server Configuration
CORE_AI_ENGINE_HOST=0.0.0.0
CORE_AI_ENGINE_PORT=8000

# Default model to use
DEFAULT_MODEL=llama3-70b

# Enable debug logging
DEBUG=false